# Опционально: nginx перед приложением для HTTPS.
# Статику и /api отдаёт сам Express (порт 4100), поэтому nginx нужен в основном для TLS.
# /etc/nginx/sites-available/vst13 -> sites-enabled, заменить server_name.

server {
    listen 80;
    server_name example.com;

    client_max_body_size 50M; # запас под загрузку фото и 3D-моделей

    location / {
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTPS: sudo certbot --nginx -d example.com
