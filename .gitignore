# Зависимости
node_modules/

# Сборка клиента (собирается в CI)
client/dist/

# Логи
*.log
npm-debug.log*

# SQLite база данных — НЕ хранить в репозитории (персональные данные, хэши паролей).
# Живёт только на сервере; локально подставляется бэкапом.
server/data.db
*.db-wal
*.db-shm

# Локальные бэкапы БД
*.local-backup
server/backups/

# VAPID-ключи для пуш-уведомлений (секрет, генерируются на каждом окружении)
server/vapid.json

# Загружаемый контент в server/uploads:
# картинки храним в репозитории, 3D-модели игнорируем (runtime)
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/*.jpg
!server/uploads/*.jpeg
!server/uploads/*.png
!server/uploads/*.webp
!server/uploads/*.gif

# ОС
.DS_Store
Thumbs.db

# Локальные настройки Claude Code (обновляются автоматически)
.claude/settings.local.json
