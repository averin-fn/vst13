# Зависимости
node_modules/

# Логи
*.log
npm-debug.log*

# SQLite runtime (журналы WAL)
*.db-wal
*.db-shm

# Загружаемый контент в server/uploads:
# картинки игнорируем (runtime), 3D-модели храним в репозитории (через Git LFS)
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/*.glb
!server/uploads/*.gltf

# ОС
.DS_Store
Thumbs.db

# Локальные настройки Claude Code (обновляются автоматически)
.claude/settings.local.json
