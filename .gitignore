# Зависимости
node_modules/

# Сборка клиента (собирается в CI)
client/dist/

# Логи
*.log
npm-debug.log*

# SQLite runtime: сама база и журналы WAL — данные приложения, не версионируем.
# Каждое окружение (локально/сервер) хранит свою БД; схема и сид создаются в db.js.
server/data.db
server/backups/
*.db-wal
*.db-shm

# Загружаемый контент в server/uploads:
# картинки храним в репозитории, 3D-модели игнорируем (runtime)
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/*.jpg
!server/uploads/*.jpeg
!server/uploads/*.png
!server/uploads/*.webp
!server/uploads/*.gif

# ОС
.DS_Store
Thumbs.db

# Локальные настройки Claude Code (обновляются автоматически)
.claude/settings.local.json
